# ─────────────────────────────────────────────
# Yulux Sign — 环境变量模板
# 复制此文件为 .env.local 并填入真实值
# 切勿将 .env.local 提交到版本库
# ─────────────────────────────────────────────

# 站点基础 URL（生产环境）
NEXT_PUBLIC_SITE_URL=https://yuluxsign.com

# 后端 API 地址（Spring Boot 服务）
# ── 本地开发（二选一）──
#   不设置该变量：浏览器走同源相对路径，由 next dev 的 rewrites 反代到 http://localhost:8080（默认，零配置）
#   设为下方值  ：浏览器直连后端（走 CORS，后端默认白名单已含 http://localhost:3000）
# ── 生产（在 Vercel 项目环境变量中配置，Production scope）──
#   NEXT_PUBLIC_API_URL = https://api.yuluxsign.com   （构建期烧入 rewrites/CSP，改后必须 Redeploy）
#   API_URL            = https://api.yuluxsign.com   （运行时，SSR/ISR 服务端拉取用，本地无需设置）
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── 邮件服务（询盘表单，后端开发时启用）──
# Resend API Key（推荐）
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# INQUIRY_TO_EMAIL=hello@yuluxsign.com

# ── 文件存储（附件上传，后端开发时启用）──
# Cloudflare R2 / AWS S3
# S3_BUCKET=yulux-uploads
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# ── 分析与监控（前端可选）──
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ── 防垃圾（Cloudflare Turnstile，后端开发时启用）──
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────
# Yulux Signs — 环境变量模板
# 复制此文件为 .env.local 并填入真实值
# 切勿将 .env.local 提交到版本库
# ─────────────────────────────────────────────

# 站点基础 URL（生产环境）
NEXT_PUBLIC_SITE_URL=https://yuluxsigns.com

# ── 邮件服务（询盘表单，后端开发时启用）──
# Resend API Key（推荐）
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# INQUIRY_TO_EMAIL=hello@yuluxsigns.com

# ── 文件存储（附件上传，后端开发时启用）──
# Cloudflare R2 / AWS S3
# S3_BUCKET=yulux-uploads
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# ── 分析与监控（前端可选）──
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ── 防垃圾（Cloudflare Turnstile，后端开发时启用）──
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

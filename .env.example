# ============================================================
# docker-compose 环境变量模板（可提交；.env 本身已被 .gitignore 排除）
#
# 用法：
#   本地开发：cp .env.example .env 保持默认值即可
#     —— 根目录 docker compose up -d mysql，再在 app/ 下 mvn spring-boot:run
#        （application.yml 的默认值与本模板一致，零配置直连）
#   生产部署：cp .env.example .env 并修改所有标记（必改）的项
#     —— 密码/密钥用 openssl rand -hex 24 生成纯字母数字值，
#        避免 $ 引号 空格 与 compose 插值 / shell 转义冲突
# ============================================================

# ---------- MySQL ----------
# （必改）root 密码
MYSQL_ROOT_PASSWORD=yulux_root_pass_change_me
MYSQL_DATABASE=yulux
# 应用专用账号：官方镜像自动创建并授予该库全部权限（后端用它而非 root）
MYSQL_USER=yulux_app
# （必改）应用账号密码 —— 本地开发保持此默认值，与 application.yml 兜底默认一致
MYSQL_PASSWORD=yulux_app_pass

# ---------- 后端 Spring Boot ----------
# （必改）后台 /api/admin/** 接口访问密钥
ADMIN_API_KEY=dev-admin-key-change-me
# （必改）后台 /admin 登录账号与密码（浏览器访问）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 允许跨域访问 /api/** 的前端来源（逗号分隔）
# 本地全栈联调需要 http://localhost:3000；生产改为正式域名，如：
#   https://yuluxsign.com,https://www.yuluxsign.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 前端站点地址（后台预览默认图等用途）
# 生产改为 https://yuluxsign.com
FRONTEND_BASE_URL=http://localhost:3000

# ---------- Caddy（HTTPS 反向代理） ----------
# 后端对外域名：DNS A 记录须指向服务器公网 IP（须在首次 docker compose up 前生效）
# 本地开发不起 caddy 服务时可保持不动
API_DOMAIN=api.yuluxsign.com
